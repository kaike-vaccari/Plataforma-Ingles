# Google Gemini API (Tradução, grifos em #d6e8fa e notas gramaticais)
# Obtenha gratuitamente em: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq Cloud API (Whisper-large-v3 ultra-rápido com timestamps)
# Obtenha gratuitamente em: https://console.groq.com/keys
GROQ_API_KEY=

# (Opcional) OpenAI API caso prefira utilizar Whisper da OpenAI
OPENAI_API_KEY=
